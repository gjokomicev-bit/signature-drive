# Öffentliche Basis-URL der Website (wird u.a. für SEO/Sitemap/Open Graph verwendet)
NEXT_PUBLIC_SITE_URL=https://www.signature-drive.ch

# API-Key von https://resend.com – wird für den Versand der Buchungs-E-Mails
# (Benachrichtigung an info@signature-drive.ch + Bestätigung an den Kunden)
# benötigt. Ohne gesetzten Key wird der Versand übersprungen (nur geloggt),
# die Buchung selbst funktioniert trotzdem. "from"-Adresse in
# src/config/email.ts muss zu einer in Resend verifizierten Domain gehören.
RESEND_API_KEY=

# Zukünftige Erweiterungen (Datenbank etc.) hier ergänzen, sobald die
# In-Memory-Referenzimplementierung (src/lib/repositories) durch echte
# Integrationen ersetzt wird, z.B.:
# DATABASE_URL=
